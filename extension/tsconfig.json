{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "chrome",
      "vitest/globals"
    ],
    "rootDir": ".",
    "tsBuildInfoFile": "dist/extension.tsbuildinfo",
    "paths": {
      "@shame-the-web/shared": [
        "../shared/src/index.ts"
      ]
    }
  },
  "include": [
    ".plasmo/index.d.ts",
    "*.ts",
    "*.tsx",
    "contents/**/*.ts",
    "tabs/**/*.tsx",
    "src/**/*.ts",
    "tests/**/*.ts"
  ],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
